# ============================================================
# widokinaraj.pl Video Generation Pipeline Environment Config
# ============================================================

# OpenAI API Key (used for GPT-4o scene analysis & optional OpenAI TTS / DALL-E 3)
OPENAI_API_KEY=your_openai_api_key_here

# Voice / TTS Provider ('clone' for XTTS v2 voice cloning from sample audio, or 'edge' for free Edge TTS)
VOICE_PROVIDER=clone
VOICE_SAMPLE_PATH=c:\proj\wnr\VID-20260727-WA0000.mp3
EDGE_VOICE=pl-PL-MarekNeural

# Image Generation Provider ('pollinations' for 16:9 images, or 'openai' for DALL-E 3)
IMAGE_PROVIDER=pollinations
POLLINATIONS_API_KEY=your_pollinations_api_key_here
